# Set at BUILD time (the site is a static export). On the live site these are stored in AWS Amplify
# (Hosting > Environment variables); for local work copy this file to .env.local.
# Every value is optional: with none set, the map uses free tiles and the pins come from data/pois.json.

# Amazon Location Service ("Amazon Map" view). The API key is restricted to this map and to the website's address.
NEXT_PUBLIC_AWS_REGION=eu-north-1
NEXT_PUBLIC_LOCATION_MAP_NAME=unilorin-nav-map
NEXT_PUBLIC_LOCATION_API_KEY=

# API Gateway invoke URL (stack output ApiUrl). Leave empty to use the bundled data/pois.json.
NEXT_PUBLIC_API_URL=

# Opt-in walk sharing. Leave UNSET (off) until the privacy review in docs/PRIVACY.md is done; set to "on" to enable.
NEXT_PUBLIC_WALK_SHARING=
