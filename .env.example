# Set at BUILD time (the site is a static export). scripts/deploy-site.sh reads these from AWS for you.
# Amazon Location Service (restrict the API key to your domain in the AWS console)
NEXT_PUBLIC_AWS_REGION=eu-north-1
NEXT_PUBLIC_LOCATION_MAP_NAME=unilorin-map
NEXT_PUBLIC_LOCATION_API_KEY=
# API Gateway invoke URL (leave empty to use the bundled data/pois.json)
NEXT_PUBLIC_API_URL=
